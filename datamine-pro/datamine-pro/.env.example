# Optional. The app already defaults to the production API (https://datamine-pro-api.onrender.com).
# Set this only to point at a different FastAPI service, e.g. http://localhost:8000 for local work.
# Do not include a trailing slash. Never put secrets in NEXT_PUBLIC_* variables.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to "true" to run the interface on invented sample data without contacting any server.
# Leave unset in production.
# NEXT_PUBLIC_DEMO_MODE=true
